# Copy to .env.local and fill in once your Supabase function is deployed.
# Leave these UNSET to run the app in mock mode (no backend needed).

# Your deployed translate edge function:
#   https://<project-ref>.functions.supabase.co/translate
VITE_TRANSLATE_URL=

# Supabase anon (publishable) key — required by the Supabase gateway.
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile SITE key (public). Leave unset to disable human
# verification (fine for local dev). When set, a Turnstile widget appears and a
# solved token is required to translate. Pair with the TURNSTILE_SECRET secret
# on the edge function (see README).
VITE_TURNSTILE_SITE_KEY=
